PERIOD_SPECS = {
    "5m": {"period": "5d", "interval": "5m", "points": 240},
    "15m": {"period": "30d", "interval": "15m", "points": 240},
    "1h": {"period": "730d", "interval": "1h", "points": 400},
    "1d": {"period": "1y", "interval": "1d", "points": 365},
